---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not found" hideBanner>
  <section class="relative isolate flex min-h-[60vh] items-center overflow-hidden">
    <div class="bg-aurora absolute inset-0 -z-10"></div>
    <div class="bg-grid absolute inset-0 -z-10"></div>
    <div class="mx-auto max-w-lg px-4 text-center sm:px-6">
      <p class="font-mono text-sm text-threat">404 · artifact not found</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-chalk">This page didn't pass discovery.</h1>
      <p class="mt-3 text-fog">The link is broken or the page moved.</p>
      <div class="mt-7 flex justify-center gap-3">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/docs" variant="ghost">Docs</Button>
      </div>
    </div>
  </section>
</Base>
