---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { site } from '../data/site';

const sections = [
  { id: 'terms', label: 'Terms of use' },
  { id: 'license', label: 'License grant' },
  { id: 'refunds', label: 'Refunds' },
  { id: 'privacy', label: 'Privacy' },
];
---

<Base title="Terms & privacy" hideBanner>
  <Prose title="Terms & privacy" lead="Plain-language summary. A formal agreement is provided at checkout." sections={sections}>
    <h2 id="terms">Terms of use</h2>
    <p>
      Talyx is provided as-is. It is a security aid, not a guarantee — you
      remain responsible for what your agents run. We work hard to keep false
      blocks near zero and to catch real threats, and we document the limits
      openly on the <a href="/security">threat model</a> page.
    </p>

    <h2 id="license">License grant</h2>
    <p>
      A purchase grants one named developer a non-exclusive, non-transferable
      license to install and use Talyx on up to 3 machines they control, for
      the license term. Team licenses cover the purchased seat count. You may
      read the source for audit; you may not redistribute the binaries or resell
      access.
    </p>

    <h2 id="refunds">Refunds</h2>
    <p>
      14 days, no questions asked, processed through Lemon Squeezy — our
      merchant of record, who also handles any applicable sales tax / VAT.
      Email <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <h2 id="privacy">Privacy</h2>
    <p>
      The software collects nothing. This website uses no third-party analytics
      or advertising trackers. Checkout is handled by Lemon Squeezy under
      <a href="https://www.lemonsqueezy.com/privacy">their privacy policy</a>;
      we receive your name, email and license status to provide support and
      renewals, nothing more.
    </p>
  </Prose>
</Base>
