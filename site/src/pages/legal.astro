---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { site } from '../data/site';

const sections = [
  { id: 'terms', label: 'Terms of use' },
  { id: 'license', label: 'License' },
  { id: 'privacy', label: 'Privacy' },
];
---

<Base title="Terms & privacy" hideBanner>
  <Prose title="Terms & privacy" lead="Plain-language summary." sections={sections}>
    <h2 id="terms">Terms of use</h2>
    <p>
      Talyx is provided as-is. It is a security aid, not a guarantee — you
      remain responsible for what your agents run. We work hard to keep false
      blocks near zero and to catch real threats, and we document the limits
      openly on the <a href="/security">threat model</a> page.
    </p>

    <h2 id="license">License</h2>
    <p>
      Talyx is free to use — no license key, no account, no payment. It ships
      under a source-available license (see <code>LICENSE</code> in the
      repository): you may read, compile, run and security-audit every line at
      no cost. Redistribution and reselling are governed by that license — read
      it for the details.
    </p>

    <h2 id="privacy">Privacy</h2>
    <p>
      The software collects nothing — no telemetry, no account, no licensing
      call, no "phone home". This website uses no third-party analytics or
      advertising trackers. There is no checkout and no payment, so we never
      receive any billing information. Questions? Email
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </Prose>
</Base>
