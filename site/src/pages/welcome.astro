---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
---

<Base
  title="Welcome"
  description="Thanks for buying Talyx. Install, activate and turn on protection in one command."
  hideBanner
>
  <section class="relative isolate overflow-hidden border-b border-line">
    <div class="bg-aurora absolute inset-0 -z-10 opacity-70"></div>
    <div class="bg-grid absolute inset-0 -z-10"></div>
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-panel/60 px-3 py-1 text-xs font-semibold text-safe">
        <Icon name="check" class="h-4 w-4" /> Payment complete
      </p>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-chalk sm:text-5xl">
        You're in. Let's get you protected.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-fog">
        Your license key is in your confirmation email and on your Lemon Squeezy
        order page. Paste it into the command below — that's the whole setup.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <!-- step 1 -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-panel-2 text-sm font-semibold text-signal hairline">1</span>
      <h2 class="text-xl font-semibold text-chalk">Install &amp; activate — one command</h2>
    </div>
    <p class="mt-3 text-sm text-mist">
      Replace <code class="rounded bg-panel-2 px-1 text-fog">&lt;KEY&gt;</code>
      with your license key. This installs Talyx, activates the license, scans
      your agents, and turns on protection at the recommended preset.
    </p>

    <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-mist">macOS / Linux</p>
    <div class="mt-2 overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5">
      <code class="whitespace-nowrap font-mono text-[13px] text-fog"
        >curl -fsSL https://{site.domain}/install.sh | sh -s -- --activate &lt;KEY&gt; --enforce</code
      >
    </div>

    <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-mist">Windows (PowerShell)</p>
    <div class="mt-2 overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5">
      <code class="whitespace-nowrap font-mono text-[13px] text-fog"
        >$env:TALYX_LICENSE_KEY="&lt;KEY&gt;"; $env:TALYX_ENFORCE="1"; irm https://{site.domain}/install.ps1 | iex</code
      >
    </div>

    <p class="mt-4 text-sm text-mist">
      Already installed Talyx? Just run
      <code class="rounded bg-panel-2 px-1 text-fog">talyx quickstart &lt;KEY&gt;</code>.
      Everything is reversible with
      <code class="rounded bg-panel-2 px-1 text-fog">talyx uninstall</code>.
    </p>

    <!-- step 2 -->
    <div class="mt-12 flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-panel-2 text-sm font-semibold text-signal hairline">2</span>
      <h2 class="text-xl font-semibold text-chalk">Confirm it's working</h2>
    </div>
    <div class="mt-3 overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5">
      <code class="whitespace-nowrap font-mono text-[13px] text-fog">talyx status</code>
    </div>
    <p class="mt-3 text-sm text-mist">
      Shows what's protected on this machine.
      <code class="rounded bg-panel-2 px-1 text-fog">talyx report</code> gives the
      full posture, and <code class="rounded bg-panel-2 px-1 text-fog">talyx why &lt;id&gt;</code>
      explains any decision.
    </p>

    <!-- help -->
    <div class="panel mt-12 p-6">
      <h3 class="font-semibold text-chalk">Can't find your key?</h3>
      <p class="mt-2 text-sm text-mist">
        It's in your purchase confirmation email and on your Lemon Squeezy order
        page (a UUID like <code class="rounded bg-panel-2 px-1 text-fog">xxxxxxxx-xxxx-…</code>).
        Activate on up to 3 machines. Still stuck? Email
        <a href={`mailto:${site.email}`} class="text-signal underline-offset-4 hover:underline">{site.email}</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm">
        <a href="/docs" class="inline-flex items-center gap-1.5 text-signal underline-offset-4 hover:underline">
          Full documentation <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/faq" class="inline-flex items-center gap-1.5 text-signal underline-offset-4 hover:underline">
          FAQ <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</Base>
