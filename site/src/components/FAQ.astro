---
import { faqs } from '../data/content';
---

<section id="faq" class="scroll-mt-20 border-t border-line bg-void">
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-chalk sm:text-4xl" data-reveal>
      Questions security teams ask.
    </h2>

    <div class="mt-10 divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <details class="group py-4" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-medium text-chalk [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="shrink-0 text-mist transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-mist">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
