---
import { detections } from '../data/content';
import { site } from '../data/site';

const sev = {
  critical: { label: 'Critical', dot: 'bg-threat', text: 'text-threat', ring: 'ring-threat/30' },
  high: { label: 'High', dot: 'bg-warn', text: 'text-warn', ring: 'ring-warn/30' },
  medium: { label: 'Medium', dot: 'bg-signal', text: 'text-signal', ring: 'ring-signal/30' },
} as const;

const order = ['critical', 'high', 'medium'] as const;
const grouped = order.map((s) => ({ s, rows: detections.filter((d) => d.severity === s) }));
---

<section id="detections" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs uppercase tracking-[0.2em] text-signal">Detection taxonomy</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
        {site.attackClasses} attack classes, one pass.
      </h2>
      <p class="mt-4 text-lg text-fog">
        Every detection is a rule in the repository, covered by tests — many
        proven against live adversarial fixtures. This is the whole list.
      </p>
    </div>

    <div class="mt-14 space-y-10">
      {
        grouped.map(({ s, rows }) => (
          <div data-reveal>
            <div class="mb-4 flex items-center gap-2.5">
              <span class={`h-2 w-2 rounded-full ${sev[s].dot}`} />
              <h3 class={`text-xs font-bold uppercase tracking-wider ${sev[s].text}`}>
                {sev[s].label}
              </h3>
              <span class="h-px flex-1 bg-line" />
              <span class="text-xs text-mist">{rows.length}</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {rows.map((d) => (
                <article class={`panel p-5 ring-1 ring-inset ${sev[s].ring}`}>
                  <h4 class="text-sm font-semibold text-chalk">{d.name}</h4>
                  <p class="mt-1 text-[11px] uppercase tracking-wider text-mist">{d.where}</p>
                  <p class="mt-2.5 text-[13px] leading-relaxed text-mist">{d.blurb}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
