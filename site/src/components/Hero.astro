---
import { site } from '../data/site';
import Button from './Button.astro';
import ThreatDemo from './ThreatDemo.astro';
import Icon from './Icon.astro';
---

<section class="relative isolate overflow-hidden">
  <div class="bg-aurora absolute inset-0 -z-10"></div>
  <div class="bg-grid absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24 lg:pb-28">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <div
          class="inline-flex items-start gap-2 rounded-2xl hairline bg-panel/60 px-3 py-1.5 text-xs leading-snug text-fog sm:items-center sm:rounded-full"
          data-reveal
        >
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-safe sm:mt-0"></span>
          Your agent runs whatever its config says. So do you.
        </div>

        <h1
          class="mt-6 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-chalk sm:text-5xl lg:text-[3.5rem]"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          Your AI coding agent loads
          <span class="text-gradient">code you never reviewed.</span>
        </h1>

        <p
          class="mt-5 max-w-xl text-lg text-fog"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          MCP servers, skills, plugins, hooks — pulled from config files, npm and
          random gists, then handed straight to a model that does what it's told.
          <strong class="text-chalk">AgentGuard</strong> scans every one of them
          across {site.agentsCovered} agents, and physically blocks the malicious ones.
          Local. Auditable. No telemetry.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 180ms">
          <Button href="/pricing" variant="primary">
            Secure your agents — ${site.price.amount}/yr
            <Icon name="arrow" class="h-4 w-4" />
          </Button>
          <Button href="/#how" variant="ghost">
            <Icon name="terminal" class="h-4 w-4" /> See a scan
          </Button>
        </div>

        <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-line pt-6" data-reveal style="--reveal-delay: 240ms">
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">{site.agentsCovered}</dt>
            <dd class="text-xs text-mist">agents covered</dd>
          </div>
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">7</dt>
            <dd class="text-xs text-mist">attack classes detected</dd>
          </div>
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">0</dt>
            <dd class="text-xs text-mist">bytes sent off-machine</dd>
          </div>
        </dl>
      </div>

      <div class="animate-float" data-reveal style="--reveal-delay: 160ms">
        <ThreatDemo />
      </div>
    </div>
  </div>
</section>
