---
import { site } from '../data/site';
import Button from './Button.astro';
import ThreatDemo from './ThreatDemo.astro';
import FlowField from './FlowField.astro';
import Icon from './Icon.astro';
---

<section class="relative isolate overflow-hidden">
  <div class="bg-aurora absolute inset-0 -z-10"></div>
  <FlowField />
  <div class="bg-grid absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pt-16 lg:pb-28">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.12fr] lg:gap-12">
      <!-- one reveal block — no internal stagger, so nothing reflows -->
      <div data-reveal>
        <p
          class="text-[10px] uppercase tracking-[0.16em] text-signal sm:text-xs sm:tracking-[0.2em]"
        >
          Supply-chain security for AI coding agents
        </p>

        <h1
          class="mt-4 text-[2.75rem] font-bold leading-[1.02] tracking-[-0.025em] text-chalk sm:text-[3.4rem] lg:text-[4rem]"
        >
          Your agents run
          <span class="relative whitespace-nowrap">
            <span class="text-gradient">untrusted code.</span>
            <svg
              class="absolute -bottom-2 left-0 h-2.5 w-full text-signal/50"
              viewBox="0 0 300 12"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 9c40-6 100-8 148-6 46 2 100 1 148-3"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"></path>
            </svg>
          </span>
        </h1>

        <p class="mt-8 max-w-xl text-[1.0625rem] leading-relaxed text-fog">
          Cursor, Claude Code, Copilot and 24 more auto-load MCP servers,
          plugins and skills — code you never reviewed, running with your
          shell and your credentials.
        </p>
        <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-chalk">
          <strong>Talyx scans every one and blocks the malicious ones before
          they load.</strong>
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href="/pricing" variant="primary">
            Lock down your agents — ${site.price.amount} once
            <Icon name="arrow" class="h-4 w-4" />
          </Button>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-6 text-xs text-mist">
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> {site.attackClasses} attack classes
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> AST + taint, not grep
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> {site.testsGreen} tests, source-available
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> Zero telemetry, zero cloud
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> Windows · macOS · Linux
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> One ${site.price.amount} license covers every agent
          </li>
        </ul>
      </div>

      <div data-reveal style="--reveal-delay: 90ms">
        <ThreatDemo />
      </div>
    </div>
  </div>
</section>
