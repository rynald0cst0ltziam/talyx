---
import { site } from '../data/site';
import Button from './Button.astro';
import ThreatDemo from './ThreatDemo.astro';
import FlowField from './FlowField.astro';
import Icon from './Icon.astro';

// The core, in three moves — surfaced right in the hero so a first-time
// visitor sees exactly what Talyx does before scrolling.
const pillars = [
  {
    icon: 'radar' as const,
    title: 'Discover',
    body: 'Every artifact your 27 agents auto-load — MCP servers, plugins, skills, hooks.',
  },
  {
    icon: 'flow' as const,
    title: 'Verify',
    body: 'A real AST + source-to-sink taint engine, content analysis, a known-bad feed.',
  },
  {
    icon: 'shield' as const,
    title: 'Enforce',
    body: 'Malicious ones removed or quarantined — the agent physically can’t load them.',
  },
];
---

<section class="relative isolate overflow-hidden">
  <div class="bg-aurora absolute inset-0 -z-10"></div>
  <FlowField />
  <div class="bg-grid absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pt-16 lg:pb-28">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.12fr] lg:gap-12">
      <!-- one reveal block — no internal stagger, so nothing reflows -->
      <div data-reveal>
        <h1
          class="text-[2.6rem] font-bold leading-[1.03] tracking-[-0.03em] text-chalk sm:text-[3.3rem] lg:text-[3.85rem]"
        >
          Antivirus for your
          <span class="relative whitespace-nowrap">
            <span class="text-gradient">AI coding agents.</span>
            <svg
              class="absolute -bottom-2 left-0 h-2.5 w-full text-signal/50"
              viewBox="0 0 300 12"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 9c40-6 100-8 148-6 46 2 100 1 148-3"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"></path>
            </svg>
          </span>
        </h1>

        <p class="mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-fog">
          Cursor, Claude Code, Copilot and 24 more auto-load MCP servers,
          plugins, skills and hooks — unreviewed code that runs with your
          shell and your credentials.
          <strong class="text-chalk">
            Talyx finds every one across 27 agents, proves what it can really
            do, and blocks the malicious ones before they load.
          </strong>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <Button href="/pricing" variant="primary">
            Lock down your agents — ${site.price.amount} once
            <Icon name="arrow" class="h-4 w-4" />
          </Button>
          <a
            href="/#how"
            class="inline-flex items-center gap-2 rounded-xl px-2 py-3 text-sm font-semibold text-fog transition-colors hover:text-chalk"
          >
            See how it works
            <Icon name="arrow" class="h-4 w-4 text-signal" />
          </a>
        </div>

        <!-- the core, in three moves -->
        <div class="mt-9 grid grid-cols-3 gap-4 border-t border-line pt-7">
          {
            pillars.map((p) => (
              <div class="flex flex-col gap-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-panel-2 text-signal hairline">
                  <Icon name={p.icon} class="h-5 w-5" />
                </div>
                <p class="text-sm font-semibold text-chalk">{p.title}</p>
                <p class="text-xs leading-snug text-mist">{p.body}</p>
              </div>
            ))
          }
        </div>

        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-xs text-mist">
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> {site.attackClasses} attack classes
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> AST + taint, not grep
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> Fully local · zero telemetry
          </li>
          <li class="flex items-center gap-1.5">
            <Icon name="check" class="h-3.5 w-3.5 text-safe" /> Windows · macOS · Linux
          </li>
        </ul>
      </div>

      <div data-reveal style="--reveal-delay: 90ms">
        <ThreatDemo />
      </div>
    </div>
  </div>
</section>
