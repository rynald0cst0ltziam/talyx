---
import { site } from '../data/site';
import Button from './Button.astro';
import ThreatDemo from './ThreatDemo.astro';
import Icon from './Icon.astro';
---

<section class="relative isolate overflow-hidden">
  <div class="bg-aurora absolute inset-0 -z-10"></div>
  <div class="bg-grid absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-4 pb-20 pt-14 sm:px-6 sm:pt-20 lg:pb-28">
    <div class="grid items-center gap-14 lg:grid-cols-[1.08fr_1fr]">
      <div>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-line-bright/60 bg-panel/50 py-1 pl-1.5 pr-3 text-xs text-fog"
          data-reveal
        >
          <span
            class="inline-flex items-center gap-1 rounded-full bg-signal/15 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-signal"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-signal"></span> {site.agentsCovered} agents
          </span>
          The supply chain for AI coding agents
        </div>

        <h1
          class="mt-6 text-balance text-[2.6rem] font-bold leading-[1.03] tracking-[-0.02em] text-chalk sm:text-[3.25rem] lg:text-[3.9rem]"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          Your agent runs code
          <span class="relative whitespace-nowrap">
            <span class="text-gradient">you never saw.</span>
            <svg
              class="absolute -bottom-1.5 left-0 h-2.5 w-full text-signal/50"
              viewBox="0 0 300 12"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 9c40-6 100-8 148-6 46 2 100 1 148-3"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
              ></path>
            </svg>
          </span>
        </h1>

        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-fog"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          MCP servers, skills, plugins, extensions, hooks — pulled from config
          files, npm and random gists, then handed to a model that does what
          it's told. <strong class="text-chalk">AgentGuard</strong> scans every
          one with a real tree-sitter AST and source-to-sink taint — not a grep —
          and physically blocks the malicious ones.
          <span class="text-mist">Local. Auditable. No telemetry.</span>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 180ms">
          <Button href="/pricing" variant="primary">
            Secure your agents — ${site.price.amount}/yr
            <Icon name="arrow" class="h-4 w-4" />
          </Button>
          <Button href="/#how" variant="ghost">
            <Icon name="terminal" class="h-4 w-4" /> See a scan
          </Button>
        </div>

        <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-line pt-6" data-reveal style="--reveal-delay: 240ms">
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">{site.agentsCovered}</dt>
            <dd class="text-xs text-mist">agents covered</dd>
          </div>
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">{site.attackClasses}</dt>
            <dd class="text-xs text-mist">attack classes detected</dd>
          </div>
          <div>
            <dt class="text-2xl font-bold text-chalk tabular">0</dt>
            <dd class="text-xs text-mist">bytes sent off-machine</dd>
          </div>
        </dl>
      </div>

      <div class="animate-float" data-reveal style="--reveal-delay: 160ms">
        <ThreatDemo />
      </div>
    </div>
  </div>
</section>
