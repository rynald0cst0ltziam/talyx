---
import { site } from '../data/site';
import Icon from './Icon.astro';

const links = [
  { label: 'Features', href: '/#features' },
  { label: 'How it works', href: '/#how' },
  { label: 'Compare', href: '/#compare' },
  { label: 'Docs', href: '/docs' },
  { label: 'Pricing', href: '/pricing' },
];
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-ink/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold text-chalk">
      <span class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-panel-2 hairline">
        <Icon name="shield" class="h-4.5 w-4.5 text-signal" />
        <span class="absolute inset-0 rounded-lg bg-signal/10 blur-md"></span>
      </span>
      <span>{site.name}</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a href={l.href} class="text-sm text-mist transition-colors hover:text-chalk">
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={site.github}
        class="hidden text-mist transition-colors hover:text-chalk sm:block"
        aria-label="GitHub"
      >
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a
        href="/pricing"
        class="btn-glow hidden items-center gap-1.5 rounded-xl bg-signal px-4 py-2 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:brightness-110 sm:inline-flex"
      >
        Get AgentGuard
      </a>
      <button
        id="nav-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-lg hairline text-chalk md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <Icon name="dash" class="h-5 w-5" />
      </button>
    </div>
  </nav>

  <div id="nav-mobile" class="hidden border-t border-line bg-void px-4 py-3 md:hidden">
    {
      links.map((l) => (
        <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm text-fog hover:bg-panel-2">
          {l.label}
        </a>
      ))
    }
    <a
      href="/pricing"
      class="mt-2 block rounded-lg bg-signal px-3 py-2.5 text-center text-sm font-semibold text-ink"
    >
      Get AgentGuard — ${site.price.amount}/yr
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden')),
  );
</script>
