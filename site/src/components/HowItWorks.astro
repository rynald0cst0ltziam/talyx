---
import { steps } from '../data/content';
import Icon from './Icon.astro';
---

<section id="how" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs uppercase tracking-[0.2em] text-signal">Buy → protected</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
        From install to enforced — with reports to prove it.
      </h2>
      <p class="mt-4 text-lg text-fog">
        No config file to write, no rules to tune. One guided setup, one preset,
        and every agent is protected — plus a posture report you can hand to
        anyone.
      </p>
    </div>

    <!-- fastest path: one command does the whole thing -->
    <div class="panel mt-10 p-5 sm:p-6" data-reveal>
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-signal">
        <Icon name="bolt" class="h-4 w-4" /> Fastest path — one command
      </div>
      <div
        class="mt-3 flex items-center gap-2 overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5"
      >
        <span class="select-none text-mist">$</span>
        <code class="whitespace-nowrap font-mono text-[13px] text-fog"
          >curl -fsSL https://gettalyx.dev/install.sh | sh -s -- --activate &lt;KEY&gt; --enforce</code
        >
      </div>
      <p class="mt-3 text-sm text-mist">
        Installs, activates your license and turns on protection at the
        recommended preset — in a single paste. Already installed?
        <code class="rounded bg-panel-2 px-1 text-[0.9em] text-fog">talyx quickstart &lt;KEY&gt;</code>
        does the same. Reversible any time with <code
          class="rounded bg-panel-2 px-1 text-[0.9em] text-fog">talyx uninstall</code
        >.
      </p>
    </div>

    <p class="mt-12 text-xs uppercase tracking-[0.2em] text-mist" data-reveal>
      Or step by step
    </p>

    <ol class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        steps.map((s, i) => (
          <li
            class="panel flex flex-col p-6"
            data-reveal
            style={`--reveal-delay:${(i % 2) * 80}ms`}
          >
            <div class="flex items-center gap-3">
              <span class="text-sm text-signal">{s.n}</span>
              <h3 class="text-lg font-semibold text-chalk">{s.title}</h3>
            </div>
            <p class="mt-2 text-sm text-mist">{s.body}</p>
            {s.code && (
              <div class="mt-4 flex items-center gap-2 overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5">
                <span class="select-none text-mist">$</span>
                <code class="whitespace-nowrap font-mono text-[13px] text-fog">{s.code}</code>
              </div>
            )}
          </li>
        ))
      }
    </ol>

    <p class="mt-8 text-center text-sm text-mist" data-reveal>
      Prefer to read the code first? The scanner core is source-available —
      <a href="/security" class="text-signal underline-offset-4 hover:underline">every detection is auditable</a>.
    </p>
  </div>
</section>
