---
/**
 * The one picture that explains why AgentGuard isn't a linter: a secret
 * value tracked from the read, through a helper, to the network — and
 * stopped. SMIL animation, no JS, pauses under reduced motion.
 */
---

<section class="scroll-mt-20 border-t border-line bg-void">
  <div class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal">Source → sink</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
        A grep sees two lines. It can't see the flow between them.
      </h2>
      <p class="mt-4 text-lg text-fog">
        <code class="rounded bg-panel-2 px-1.5 py-0.5 text-[0.9em] text-fog">readFileSync</code>
        and <code class="rounded bg-panel-2 px-1.5 py-0.5 text-[0.9em] text-fog">fetch</code>
        both appear in a thousand honest files. AgentGuard's taint pass follows
        the value from one to the other — across variables, helper functions and
        parameters — and gates it before it launches.
      </p>
    </div>

    <div
      class="panel mx-auto mt-12 max-w-3xl overflow-hidden p-4 shadow-[var(--shadow-panel)] sm:p-6"
      data-reveal
    >
      <svg
        class="ag-taint w-full"
        viewBox="0 0 720 220"
        fill="none"
        role="img"
        aria-label="A secret read from an SSH key file flows through a helper function to a fetch call and is blocked before it reaches the network."
      >
        <defs>
          <linearGradient id="tf-wire" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3ee9a4"></stop>
            <stop offset="0.5" stop-color="#4de3ff"></stop>
            <stop offset="1" stop-color="#ff5470"></stop>
          </linearGradient>
          <filter id="tf-glow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="3.2" result="b"></feGaussianBlur>
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <!-- route the tainted token travels: source → helper → sink -->
          <path id="tf-route" d="M120 110 H300 M300 110 H500 M500 110 H600" />
        </defs>

        <!-- connective wire -->
        <path d="M120 110 H600" stroke="url(#tf-wire)" stroke-width="2" stroke-opacity="0.35" />
        <path d="M120 110 H600" stroke="url(#tf-wire)" stroke-width="2" stroke-dasharray="4 6" stroke-opacity="0.7">
          <animate attributeName="stroke-dashoffset" from="0" to="-100" dur="2.4s" repeatCount="indefinite" />
        </path>

        <!-- nodes -->
        <g class="ag-node">
          <rect x="24" y="82" width="96" height="56" rx="10" fill="#0a0c12" stroke="#3ee9a4" stroke-opacity="0.5" />
          <text x="72" y="106" text-anchor="middle" class="tf-kind" fill="#3ee9a4">SOURCE</text>
          <text x="72" y="124" text-anchor="middle" class="tf-code" fill="#b7bdce">readFileSync</text>
        </g>
        <g class="ag-node">
          <rect x="252" y="82" width="96" height="56" rx="10" fill="#0a0c12" stroke="#313a52" />
          <text x="300" y="106" text-anchor="middle" class="tf-kind" fill="#8b93a7">helper()</text>
          <text x="300" y="124" text-anchor="middle" class="tf-code" fill="#b7bdce">buildPayload</text>
        </g>
        <g class="ag-node">
          <rect x="452" y="82" width="96" height="56" rx="10" fill="#0a0c12" stroke="#4de3ff" stroke-opacity="0.5" />
          <text x="500" y="106" text-anchor="middle" class="tf-kind" fill="#4de3ff">SINK</text>
          <text x="500" y="124" text-anchor="middle" class="tf-code" fill="#b7bdce">fetch(body)</text>
        </g>

        <!-- the shield that intercepts, before the network -->
        <g transform="translate(600 110)">
          <g class="tf-shield">
            <path
              d="M0 -22 -16 -16 v14 c0 11 7 18 16 22 9-4 16-11 16-22 v-14Z"
              fill="#10131c"
              stroke="#ff5470"
              stroke-width="2"
            ></path>
            <path d="m-7 0 5 5 9-10" stroke="#ff5470" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </g>
        </g>
        <text x="600" y="164" text-anchor="middle" class="tf-blocked" fill="#ff5470">BLOCKED</text>

        <text x="660" y="114" class="tf-net" fill="#8b93a7">→ network</text>

        <!-- the tainted secret, travelling then absorbed at the shield -->
        <circle r="5" fill="#ff5470" filter="url(#tf-glow)">
          <animateMotion dur="4.4s" repeatCount="indefinite" keyPoints="0;0.34;0.4;0.72;0.78;0.97;1" keyTimes="0;0.28;0.36;0.6;0.68;0.9;1" calcMode="linear">
            <mpath href="#tf-route" />
          </animateMotion>
          <animate attributeName="opacity" dur="4.4s" repeatCount="indefinite" values="0;1;1;1;1;1;0" keyTimes="0;0.05;0.5;0.85;0.9;0.93;1" />
          <animate attributeName="r" dur="4.4s" repeatCount="indefinite" values="4;4;4;4;9;0;0" keyTimes="0;0.5;0.85;0.9;0.93;0.95;1" />
        </circle>
      </svg>
    </div>
  </div>
</section>

<style>
  .ag-taint .tf-kind {
    font: 700 8px var(--font-mono);
    letter-spacing: 0.12em;
  }
  .ag-taint .tf-code {
    font: 500 10px var(--font-mono);
  }
  .ag-taint .tf-net {
    font: 500 11px var(--font-mono);
  }
  .ag-taint .tf-blocked {
    font: 700 10px var(--font-mono);
    letter-spacing: 0.14em;
    opacity: 0;
    animation: tf-stamp 4.4s linear infinite;
  }
  .ag-taint .tf-shield {
    opacity: 0;
    transform-origin: center;
    animation: tf-catch 4.4s linear infinite;
  }
  @keyframes tf-stamp {
    0%,
    88% {
      opacity: 0;
    }
    90% {
      opacity: 1;
      transform: scale(1.15);
    }
    95%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes tf-catch {
    0%,
    82% {
      opacity: 0;
      transform: scale(0.6);
    }
    88% {
      opacity: 1;
      transform: scale(1.12);
    }
    92%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ag-taint :global(animate),
    .ag-taint :global(animateMotion) {
      display: none;
    }
    .ag-taint .tf-blocked,
    .ag-taint .tf-shield {
      opacity: 1;
      animation: none;
    }
  }
</style>
