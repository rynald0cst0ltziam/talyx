---
/**
 * The one picture that explains why AgentGuard isn't a linter: a secret
 * value tracked from a file read, through a helper, toward the network —
 * stopped at a barrier before it leaves the machine.
 *
 * The moving parts are one horizontal band of SMIL on a 6s loop. The
 * verdict is a separate HTML row *below* the stage — it can never overlap
 * the diagram because it lives in normal flow. A tiny rAF ticker (paused
 * under reduced motion) swaps the status label and flips the verdict row.
 */
const D = '6s';
---

<section id="taint" class="scroll-mt-20 border-t border-line bg-void">
  <div class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal">Source → sink</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
        A grep sees two lines. It can't see the flow between them.
      </h2>
      <p class="mt-4 text-lg text-fog">
        <code class="rounded bg-panel-2 px-1.5 py-0.5 text-[0.9em] text-fog">readFileSync</code>
        and <code class="rounded bg-panel-2 px-1.5 py-0.5 text-[0.9em] text-fog">fetch</code>
        both show up in a thousand honest files. AgentGuard's taint pass follows
        the value from one to the other — across variables, helper functions and
        parameters — and stops it before it leaves the machine.
      </p>
    </div>

    <div class="ag-taint panel mx-auto mt-12 max-w-3xl overflow-hidden shadow-[var(--shadow-panel)]" data-reveal>
      <div class="flex items-center gap-2 border-b border-line bg-[#0c0f17] px-4 py-2.5 font-mono text-[11px] text-mist">
        <span class="inline-flex items-center gap-1.5">
          <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
            <circle cx="4" cy="4" r="4" fill="#3ee9a4">
              <animate attributeName="fill" dur={D} repeatCount="indefinite" calcMode="discrete"
                values="#3ee9a4;#3ee9a4;#ffb84d;#ff5470;#ff5470;#3ee9a4"
                keyTimes="0;0.40;0.46;0.72;0.96;1" />
            </circle>
          </svg>
          <span class="tf-status">watching</span>
        </span>
        <span class="ml-auto">agentguard · taint engine</span>
      </div>

      <!-- the flow -->
      <div class="px-3 pt-7 pb-3 sm:px-6">
        <svg class="ag-taint-svg w-full" viewBox="0 0 800 170" fill="none" role="img"
          aria-label="A secret read from a key file flows through a helper toward a fetch call and is blocked at a barrier before it reaches the network.">
          <defs>
            <pattern id="tf-grid" width="25" height="25" patternUnits="userSpaceOnUse">
              <path d="M25 0H0V25" fill="none" stroke="#4de3ff" stroke-opacity="0.05" stroke-width="1" />
            </pattern>
            <filter id="tf-glow" x="-150%" y="-150%" width="400%" height="400%">
              <feGaussianBlur stdDeviation="2.4" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <path id="tf-route" d="M86 72 H354 H622 H740" />
          </defs>

          <rect x="0" y="0" width="800" height="170" fill="url(#tf-grid)" />

          <!-- wire: dim base, red taint drawing over it -->
          <path d="M56 72 H740" stroke="#232838" stroke-width="2.5" />
          <path d="M56 72 H740" stroke="#ff5470" stroke-width="2.5" stroke-linecap="round"
            pathLength="100" stroke-dasharray="100">
            <animate attributeName="stroke-dashoffset" dur={D} repeatCount="indefinite" calcMode="linear"
              values="100;100;4;4;100" keyTimes="0;0.10;0.62;0.90;1" />
          </path>

          <!-- nodes -->
          <g>
            <rect x="24" y="46" width="124" height="52" rx="10" fill="#0a0c12" stroke="#3ee9a4" stroke-opacity="0.5" />
            <text x="86" y="68" text-anchor="middle" class="tf-kind" fill="#3ee9a4">SOURCE</text>
            <text x="86" y="86" text-anchor="middle" class="tf-code">readFileSync</text>
          </g>
          <g>
            <rect class="tf-mid" x="292" y="46" width="124" height="52" rx="10" fill="#0a0c12" stroke="#313a52" stroke-width="1.5">
              <animate attributeName="stroke" dur={D} repeatCount="indefinite" calcMode="discrete"
                values="#313a52;#313a52;#ff5470;#313a52;#313a52" keyTimes="0;0.28;0.34;0.44;1" />
            </rect>
            <text x="354" y="68" text-anchor="middle" class="tf-kind" fill="#8b93a7">HELPER</text>
            <text x="354" y="86" text-anchor="middle" class="tf-code">pack(key)</text>
          </g>
          <g>
            <rect class="tf-sink" x="560" y="46" width="124" height="52" rx="10" fill="#0a0c12" stroke="#4de3ff" stroke-width="1.5" stroke-opacity="0.5">
              <animate attributeName="stroke" dur={D} repeatCount="indefinite" calcMode="discrete"
                values="#4de3ff;#4de3ff;#ff5470;#ff5470;#4de3ff" keyTimes="0;0.58;0.64;0.74;1" />
              <animate attributeName="stroke-opacity" dur={D} repeatCount="indefinite" calcMode="discrete"
                values="0.5;0.5;1;1;0.5" keyTimes="0;0.58;0.64;0.74;1" />
            </rect>
            <text x="622" y="68" text-anchor="middle" class="tf-kind" fill="#4de3ff">SINK</text>
            <text x="622" y="86" text-anchor="middle" class="tf-code">fetch(body)</text>
          </g>

          <text x="740" y="128" text-anchor="middle" class="tf-net" fill="#8b93a7">network</text>

          <!-- scanner sweep -->
          <rect y="26" width="32" height="92" fill="#4de3ff" fill-opacity="0.11">
            <animate attributeName="x" dur={D} repeatCount="indefinite" calcMode="linear"
              values="-46;-46;800;800" keyTimes="0;0.42;0.58;1" />
            <animate attributeName="opacity" dur={D} repeatCount="indefinite" calcMode="linear"
              values="0;0;1;1;0;0" keyTimes="0;0.42;0.44;0.56;0.58;1" />
          </rect>

          <!-- barrier, on its own stretch of wire past the sink -->
          <g transform="translate(740 72)">
            <path d="M0-22 19-11 19 11 0 22-19 11-19-11Z" fill="none" stroke="#ff5470" stroke-width="1.5" opacity="0">
              <animate attributeName="opacity" dur={D} repeatCount="indefinite" calcMode="linear"
                values="0;0;0.9;0;0" keyTimes="0;0.70;0.74;0.86;1" />
              <animateTransform attributeName="transform" type="scale" dur={D} repeatCount="indefinite"
                calcMode="spline" values="0.6;0.6;1;1.7;1.7" keyTimes="0;0.70;0.74;0.86;1"
                keySplines="0 0 1 1;0.16 1 0.3 1;0.16 1 0.3 1;0 0 1 1" />
            </path>
            <g opacity="0">
              <animate attributeName="opacity" dur={D} repeatCount="indefinite" calcMode="linear"
                values="0;0;1;1;0;0" keyTimes="0;0.72;0.78;0.95;0.99;1" />
              <animateTransform attributeName="transform" type="scale" additive="sum" dur={D} repeatCount="indefinite"
                calcMode="spline" values="0.4;0.4;1.15;1;1;1" keyTimes="0;0.72;0.78;0.83;0.95;1"
                keySplines="0 0 1 1;0.16 1 0.3 1;0.16 1 0.3 1;0 0 1 1;0 0 1 1" />
              <path d="M0-16 14-8 14 8 0 16-14 8-14-8Z" fill="#170b10" stroke="#ff5470" stroke-width="2" />
              <path d="m-6 0 4 5 8.5-10" stroke="#ff5470" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </g>
          </g>

          <!-- the tainted secret -->
          <circle r="5" fill="#ff5470" filter="url(#tf-glow)">
            <animateMotion dur={D} repeatCount="indefinite" calcMode="linear"
              keyPoints="0;0;0.410;0.410;0.820;0.820;1;1"
              keyTimes="0;0.08;0.30;0.40;0.60;0.68;0.75;1">
              <mpath href="#tf-route" />
            </animateMotion>
            <animate attributeName="opacity" dur={D} repeatCount="indefinite" calcMode="linear"
              values="0;0;1;1;0;0" keyTimes="0;0.07;0.11;0.70;0.75;1" />
            <animate attributeName="r" dur={D} repeatCount="indefinite" calcMode="linear"
              values="5;5;5;8;0;0" keyTimes="0;0.63;0.69;0.73;0.75;1" />
          </circle>
        </svg>
      </div>

      <!-- verdict — its own row, can't overlap the stage -->
      <div class="tf-verdict flex items-center gap-2 border-t border-line px-4 py-3 font-mono text-[11px] sm:text-xs">
        <span class="tf-verdict-idle inline-flex items-center gap-2 text-mist">
          <span class="h-1.5 w-1.5 rounded-full bg-signal/70"></span>
          tracing 1 flow · secret → network
        </span>
        <span class="tf-verdict-blocked inline-flex items-center gap-2 font-semibold text-threat">
          <span class="h-1.5 w-1.5 rounded-full bg-threat"></span>
          BLOCKED · CRITICAL · secret would reach the network
        </span>
      </div>
    </div>

    <p class="mt-4 text-center text-xs text-mist" data-reveal>
      Real detection, real fixture. <code class="text-fog">agentguard init</code> removes it from the config; the shim refuses to launch it.
    </p>
  </div>
</section>

<style>
  .ag-taint-svg text {
    font-family: var(--font-mono, ui-monospace, monospace);
  }
  .ag-taint-svg .tf-kind {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .ag-taint-svg .tf-code {
    font-size: 11px;
    font-weight: 500;
    fill: #b7bdce;
  }
  .ag-taint-svg .tf-net {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  /* verdict row: idle by default; script (or reduced-motion) reveals blocked */
  .tf-verdict-blocked {
    display: none;
  }
  .ag-taint.is-blocked .tf-verdict-idle {
    display: none;
  }
  .ag-taint.is-blocked .tf-verdict-blocked {
    display: inline-flex;
  }
  .ag-taint.is-blocked .tf-verdict {
    background: color-mix(in oklab, var(--color-threat) 12%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-taint-svg :global(animate),
    .ag-taint-svg :global(animateMotion),
    .ag-taint-svg :global(animateTransform) {
      display: none;
    }
    .ag-taint-svg .tf-sink {
      stroke: #ff5470;
      stroke-opacity: 1;
    }
    .tf-verdict-idle {
      display: none;
    }
    .tf-verdict-blocked {
      display: inline-flex;
    }
    .tf-verdict {
      background: color-mix(in oklab, var(--color-threat) 12%, transparent);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.ag-taint');
  const label = root?.querySelector<HTMLElement>('.tf-status');
  if (root && label && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const CLOCK = 6000;
    const start = performance.now();
    const tick = (now: number) => {
      const t = ((now - start) % CLOCK) / CLOCK;
      const text = t >= 0.96 || t < 0.4 ? 'watching' : t < 0.72 ? 'tracing flow' : 'blocked';
      if (label.textContent !== text) label.textContent = text;
      root.classList.toggle('is-blocked', t >= 0.72 && t < 0.965);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
