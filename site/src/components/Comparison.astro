---
import { capabilities } from '../data/content';
import Icon from './Icon.astro';
---

<section id="capabilities" class="scroll-mt-20 border-t border-line bg-void">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs uppercase tracking-[0.2em] text-signal">What you get</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
        The full capability list.
      </h2>
      <p class="mt-4 text-lg text-fog">
        Every line is implemented in the repository and covered by tests, many
        proven against live adversarial fixtures. Read the code to check any of it.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2" data-reveal>
      {
        capabilities.map((r) => (
          <div class="bg-void p-5">
            <div class="flex items-start gap-2.5">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-safe" />
              <div>
                <p class="font-semibold text-chalk">{r.capability}</p>
                <p class="mt-1 text-sm leading-relaxed text-fog">{r.how}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-xs text-mist" data-reveal>
      Something unclear or wrong? <a class="underline hover:text-fog" href="mailto:rynald0cst0ltziam@gmail.com">rynald0cst0ltziam@gmail.com</a>
    </p>
  </div>
</section>
