---
import { site } from '../data/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<section class="relative isolate overflow-hidden border-t border-line">
  <div class="bg-aurora absolute inset-0 -z-10 opacity-60"></div>
  <div class="bg-grid absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6" data-reveal>
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-panel-2 hairline">
      <span class="relative">
        <Icon name="shield" class="h-7 w-7 text-signal" />
        <span class="absolute -inset-3 rounded-full bg-signal/20 blur-lg"></span>
      </span>
    </div>
    <h2 class="mt-6 text-balance text-3xl font-bold tracking-tight text-chalk sm:text-4xl">
      You audit your dependencies.
      <span class="text-gradient">Your agent doesn't.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-fog">
      One command to install, one to scan. Then every MCP server, plugin and
      skill your agents load is checked and gated. Free — every feature, no
      license, no account.
    </p>
    <div class="mx-auto mt-8 max-w-xl overflow-x-auto rounded-lg border border-line bg-ink px-3.5 py-2.5 text-left">
      <span class="select-none text-mist">$</span>
      <code class="font-mono text-[13px] text-fog">curl -fsSL {site.installSh} | sh</code>
    </div>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Button href="/docs#quickstart" variant="primary">
        Get started <Icon name="arrow" class="h-4 w-4" />
      </Button>
      <Button href={site.github} variant="ghost">View the source</Button>
    </div>
    <p class="mt-5 text-xs text-mist">
      Fully local · zero telemetry · source-available · Windows · macOS · Linux
    </p>
  </div>
</section>
